---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  cover?: string;
  readingTime?: string;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  category,
  cover,
  readingTime = '5 分钟',
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} ogImage={cover}>
  <div class="flex gap-8 max-w-7xl mx-auto">
    <!-- Table of Contents slot (left side on large screens) -->
    <slot name="toc" />

    <!-- Article Content -->
    <article class="max-w-article mx-auto flex-1 min-w-0">
      <!-- Article Header -->
      <header class="mb-8">
        <!-- Cover Image -->
        {cover && (
          <img
            src={cover}
            alt={title}
            class="w-full h-64 md:h-80 object-cover rounded-lg mb-6"
            loading="eager"
          />
        )}

        <!-- Category -->
        {category && (
          <a
            href={`/blog?category=${category}`}
            class="inline-block px-3 py-1 text-sm font-medium text-[var(--color-primary)] bg-[var(--color-primary)]/10 rounded-full mb-4 hover:bg-[var(--color-primary)]/20 transition-colors"
          >
            {category}
          </a>
        )}

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-4">
          {title}
        </h1>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-secondary)]">
          <!-- Date -->
          <time datetime={pubDate.toISOString()} class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {formattedDate}
          </time>

          <!-- Updated Date -->
          {formattedUpdatedDate && (
            <span class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              更新于 {formattedUpdatedDate}
            </span>
          )}

          <!-- Reading Time -->
          <span class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime}
          </span>
        </div>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {tags.map((tag) => (
              <a
                href={`/blog?category=${tag}`}
                class="px-3 py-1 text-sm text-[var(--color-text-secondary)] bg-[var(--color-code-bg)] rounded-full hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)] transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Article Content -->
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>

      <!-- Article Footer -->
      <footer class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <!-- Share -->
        <div class="flex items-center justify-between mb-8">
          <p class="text-[var(--color-text-secondary)]">觉得这篇文章有用吗？分享给朋友吧！</p>
          <div class="flex space-x-4">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors"
              aria-label="分享到 Twitter"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {prevPost && (
            <a
              href={`/blog/${prevPost.slug}`}
              class="p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] hover:bg-[var(--color-primary)]/5 transition-all group"
            >
              <span class="text-sm text-[var(--color-text-secondary)]">上一篇</span>
              <p class="text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors font-medium mt-1">
                {prevPost.title}
              </p>
            </a>
          )}
          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}`}
              class="p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] hover:bg-[var(--color-primary)]/5 transition-all group text-right md:col-start-2"
            >
              <span class="text-sm text-[var(--color-text-secondary)]">下一篇</span>
              <p class="text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors font-medium mt-1">
                {nextPost.title}
              </p>
            </a>
          )}
        </nav>
      </footer>
    </article>
  </div>
</BaseLayout>
