---
// PostCard.astro - 文章卡片组件
interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags?: string[];
      category?: string;
      cover?: string;
    };
  };
}

const { post } = Astro.props;
const { title, description, pubDate, tags, category, cover } = post.data;

const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group bg-[var(--color-card-bg)] rounded-xl overflow-hidden border border-[var(--color-border)] transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
  <!-- 封面图（可选） -->
  {cover && (
    <div class="relative aspect-video overflow-hidden">
      <img
        src={cover}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    </div>
  )}

  <!-- 内容区域 -->
  <div class="p-5">
    <!-- 分类 + 标签 -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      {category && (
        <a
          href={`/blog?category=${category}`}
          class="inline-block px-3 py-1 text-xs font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded-full hover:bg-[var(--color-primary)]/20 transition-colors"
        >
          {category}
        </a>
      )}
      {tags?.slice(0, 3).map((tag) => (
        <span class="inline-block px-3 py-1 text-xs font-medium bg-[var(--color-code-bg)] text-[var(--color-text-secondary)] rounded-full">
          {tag}
        </span>
      ))}
    </div>

    <!-- 标题（2行截断） -->
    <h3 class="text-lg font-bold text-[var(--color-text)] mb-2 line-clamp-2 group-hover:text-[var(--color-primary)] transition-colors font-lxgw">
      <a href={`/blog/${post.slug}`}>
        {title}
      </a>
    </h3>

    <!-- 摘要（3行截断） -->
    <p class="text-sm text-[var(--color-text-secondary)] mb-4 line-clamp-3 leading-relaxed">
      {description}
    </p>

    <!-- 发布日期 -->
    <time
      datetime={pubDate.toISOString()}
      class="text-xs text-[var(--color-text-secondary)]"
    >
      {formattedDate}
    </time>
  </div>
</article>
