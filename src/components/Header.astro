---
// Header.astro - 导航栏组件（精装修版）
import ThemeToggle from './ThemeToggle';
---

<header
  class="fixed top-0 left-0 right-0 z-50 h-16 border-b transition-all duration-300"
  style="background: var(--color-bg); border-color: var(--color-border-light);"
>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div
        class="w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:shadow-lg"
        style="background: var(--color-primary); box-shadow: 0 2px 8px oklch(0.55 0.14 70 / 0.2);"
      >
        <span class="text-white font-extrabold text-base font-lxgw">博</span>
      </div>
      <span
        class="text-lg font-bold tracking-tight font-lxgw transition-colors duration-200"
        style="color: var(--color-text);"
      >
        我的博客
      </span>
    </a>

    <!-- 导航链接（桌面端） -->
    <nav class="hidden md:flex items-center gap-1">
      <a href="/" class="nav-link inline-flex items-center px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text-secondary);">
        首页
      </a>
      <a href="/blog" class="nav-link inline-flex items-center px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text-secondary);">
        文章
      </a>
      <a href="/about" class="nav-link inline-flex items-center px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text-secondary);">
        关于
      </a>
      <a href="/rss.xml" class="nav-link inline-flex items-center px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text-secondary);" target="_blank">
        RSS
      </a>
    </nav>

    <!-- 右侧按钮组 -->
    <div class="flex items-center gap-1">
      <!-- 搜索按钮 -->
      <button
        id="search-toggle"
        class="p-2 rounded-lg transition-colors duration-200"
        style="color: var(--color-text-secondary);"
        aria-label="搜索"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- <ThemeToggle client:load /> -->
      <ThemeToggle client:load />

      <!-- 移动端汉堡菜单 -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg transition-colors duration-200"
        style="color: var(--color-text-secondary);"
        aria-label="菜单"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 移动端菜单 -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-16 left-0 right-0 border-b shadow-lg transition-all duration-200"
    style="background: var(--color-card-bg); border-color: var(--color-border-light);"
  >
    <nav class="px-4 py-5 space-y-1">
      <a href="/" class="block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text);">
        首页
      </a>
      <a href="/blog" class="block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text);">
        文章
      </a>
      <a href="/about" class="block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text);">
        关于
      </a>
      <a href="/rss.xml" class="block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-200" style="color: var(--color-text);" target="_blank">
        RSS
      </a>
    </nav>
  </div>
</header>

<script>
  // 移动端菜单切换
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuToggle && mobileMenu) {
    mobileMenuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // 搜索按钮
  const searchToggle = document.getElementById('search-toggle');
  if (searchToggle) {
    searchToggle.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('toggle-search'));
    });
  }
</script>

<style>
  /* 导航链接 hover — 下划线动画 */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    border-radius: 1px;
    background-color: var(--color-primary);
    transition: width 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-primary) !important;
    background: var(--color-primary-soft);
  }

  .nav-link:hover::after {
    width: 60%;
  }

  /* 搜索按钮 hover */
  #search-toggle:hover {
    color: var(--color-primary) !important;
    background: var(--color-primary-soft);
  }

  /* 移动端菜单链接 hover */
  #mobile-menu a:hover {
    background: var(--color-primary-soft);
    color: var(--color-primary) !important;
  }

  /* 当前页面高亮 */
  .nav-link[aria-current="page"] {
    color: var(--color-primary) !important;
    font-weight: 600;
  }

  .nav-link[aria-current="page"]::after {
    width: 60%;
  }
</style>
