---
// Footer.astro - 页脚组件
---

<footer class="bg-[var(--color-bg)] border-t border-[var(--color-border)] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col items-center space-y-6">
      <!-- 社交链接图标 -->
      <div class="flex items-center space-x-6">
        <!-- GitHub -->
        <a
          href="https://github.com/fengyinxqy"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:572752189@qq.com"
          class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors"
          aria-label="Email"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>

        <!-- RSS -->
        <a
          href="/rss.xml"
          class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors"
          aria-label="RSS"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
          </svg>
        </a>
      </div>

      <!-- 版权信息 -->
      <div class="text-center">
        <p class="text-sm text-[var(--color-text-secondary)]">
          &copy; {new Date().getFullYear()} 我的博客. All rights reserved.
        </p>
        <p class="text-xs text-[var(--color-text-secondary)] mt-2">
          使用 <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-primary)] transition-colors">Astro</a> 构建
        </p>
      </div>
    </div>
  </div>
</footer>
