---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = sortedPosts.slice(0, 3);
const latestPosts = sortedPosts.slice(3, 8);
---

<BaseLayout title="首页">
  <!-- Hero Section -->
  <section class="py-20 md:py-28 text-center">
    <!-- 装饰性标签 -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-8"
      style="background: var(--color-primary-soft); color: var(--color-primary);">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
          style="background: var(--color-primary);"></span>
        <span class="relative inline-flex rounded-full h-2 w-2"
          style="background: var(--color-primary);"></span>
      </span>
      持续更新中
    </div>

    <!-- 主标题 -->
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight tracking-tight"
      style="color: var(--color-text);">
      欢迎来到我的博客
    </h1>

    <!-- 副标题 -->
    <p class="text-lg md:text-xl max-w-xl mx-auto mb-10 leading-relaxed"
      style="color: var(--color-text-secondary);">
      分享前端开发、编程技术和生活感悟的地方。<br/>在这里，我记录学习过程，探索技术边界。
    </p>

    <!-- CTA 按钮 -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/blog" class="btn-primary">阅读文章</a>
      <a href="/about" class="btn-outline">
        了解更多
      </a>
    </div>
  </section>

  <!-- Featured Posts -->
  {featuredPosts.length > 0 && (
    <section class="py-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl md:text-2xl font-extrabold tracking-tight"
            style="color: var(--color-text); letter-spacing: -0.02em;">
            精选文章
          </h2>
          <p class="text-sm mt-1" style="color: var(--color-text-muted);">
            最值得一读的内容
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Posts -->
  {latestPosts.length > 0 && (
    <section class="py-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl md:text-2xl font-extrabold tracking-tight"
            style="color: var(--color-text); letter-spacing: -0.02em;">
            最新文章
          </h2>
          <p class="text-sm mt-1" style="color: var(--color-text-muted);">
            最近发布的内容
          </p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-1 text-sm font-semibold transition-colors duration-200"
          style="color: var(--color-primary);"
        >
          查看全部
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      <div class="space-y-1">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex items-start gap-5 p-4 -mx-4 rounded-xl transition-all duration-200"
          >
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold mb-1 transition-colors duration-200 line-clamp-1 group-hover:text-[var(--color-primary)]"
                style="color: var(--color-text); letter-spacing: -0.01em;">
                {post.data.title}
              </h3>
              <p class="text-sm line-clamp-1 mb-2" style="color: var(--color-text-secondary);">
                {post.data.description}
              </p>
              <div class="flex items-center gap-3 text-xs font-medium" style="color: var(--color-text-muted);">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                {post.data.category && (
                  <span class="inline-flex items-center gap-1">
                    <span class="w-1 h-1 rounded-full" style="background: var(--color-primary);"></span>
                    {post.data.category}
                  </span>
                )}
              </div>
            </div>
            <!-- 箭头 -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 flex-shrink-0 transition-all duration-200 group-hover:translate-x-1"
              style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Empty State -->
  {allPosts.length === 0 && (
    <section class="py-20 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl mb-6"
        style="background: var(--color-primary-soft);">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" style="color: var(--color-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
      <h2 class="text-xl font-bold mb-2" style="color: var(--color-text);">
        还没有文章
      </h2>
      <p style="color: var(--color-text-secondary);">
        开始写第一篇文章吧！
      </p>
    </section>
  )}

  <!-- Divider -->
  <div class="mt-8"></div>
</BaseLayout>
