---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Get all published blog posts, sorted by date
const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Featured posts (first 3)
const featuredPosts = sortedPosts.slice(0, 3);

// Latest posts (next 5)
const latestPosts = sortedPosts.slice(3, 8);

// Helper function to calculate reading time (Chinese-optimized)
function getReadingTime(content: string): string {
  const charCount = (content || '').replace(/\s/g, '').length;
  const minutes = Math.max(1, Math.ceil(charCount / 400));
  return `${minutes} 分钟`;
}
---

<BaseLayout title="首页">
  <!-- Hero Section -->
  <section class="py-16 md:py-24 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-text)] mb-6">
      欢迎来到我的博客
    </h1>
    <p class="text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto mb-8">
      分享前端开发、编程技术和生活感悟的地方。在这里，我记录学习过程，探索技术边界。
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/blog"
        class="inline-flex items-center justify-center px-6 py-3 bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors font-medium no-underline"
      >
        阅读文章
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a
        href="/about"
        class="inline-flex items-center justify-center px-6 py-3 border-2 border-[var(--color-primary)] text-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary)]/10 transition-colors font-medium"
      >
        了解更多
      </a>
    </div>
  </section>

  <!-- Featured Posts -->
  {featuredPosts.length > 0 && (
    <section class="py-12">
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-8">
        精选文章
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Posts -->
  {latestPosts.length > 0 && (
    <section class="py-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)]">
          最新文章
        </h2>
        <a
          href="/blog"
          class="text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors font-medium"
        >
          查看全部 →
        </a>
      </div>
      <div class="space-y-4">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex items-start gap-4 p-4 rounded-lg hover:bg-[var(--color-card-bg)] transition-colors"
          >
            <div class="flex-1">
              <h3 class="text-lg font-medium text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors mb-1">
                {post.data.title}
              </h3>
              <p class="text-[var(--color-text-secondary)] text-sm line-clamp-1 mb-2">
                {post.data.description}
              </p>
              <div class="flex items-center gap-4 text-sm text-[var(--color-text-secondary)]">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                {post.data.category && (
                  <span>{post.data.category}</span>
                )}
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-text-secondary)] group-hover:text-[var(--color-primary)] transition-colors mt-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Empty State -->
  {allPosts.length === 0 && (
    <section class="py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-[var(--color-text-secondary)] mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
      </svg>
      <h2 class="text-xl font-semibold text-[var(--color-text)] mb-2">
        还没有文章
      </h2>
      <p class="text-[var(--color-text-secondary)]">
        开始写第一篇文章吧！
      </p>
    </section>
  )}
</BaseLayout>
