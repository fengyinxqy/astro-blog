---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于我">
  <div class="max-w-article mx-auto py-8">

    <!-- ========== 1. 个人卡片 ========== -->
    <div class="text-center mb-14">
      <div class="relative inline-block mb-6">
        <img
          src="https://avatars.githubusercontent.com/u/56753804"
          alt="avatar"
          class="w-28 h-28 rounded-full object-cover"
          style="box-shadow: 0 0 0 4px var(--color-card-bg), 0 0 0 6px var(--color-primary-soft);"
          loading="eager"
        />
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3 tracking-tight"
        style="color: var(--color-text); letter-spacing: -0.02em;">
        肖祺彦
      </h1>
      <p class="text-lg mb-1" style="color: var(--color-primary); font-weight: 600;">
        Web 前端开发工程师（正在转全栈）/ AI 应用工程师
      </p>
      <p class="text-sm mb-4" style="color: var(--color-text-muted);">
        预备前端主程 · 在职，正在找工作
      </p>

      <!-- 联系信息 -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-1.5 text-sm"
        style="color: var(--color-text-secondary);">
        <span>📞 15885289601</span>
        <span>✉️ 572752189@qq.com</span>
        <a href="https://github.com/fengyinxqy" target="_blank" rel="noopener noreferrer"
          class="hover:text-[var(--color-primary)] transition-colors">
          🔗 github.com/fengyinxqy
        </a>
        <a href="https://astro-blog-khaki-one.vercel.app/" target="_blank" rel="noopener noreferrer"
          class="hover:text-[var(--color-primary)] transition-colors">
          🌐 博客
        </a>
        <span>📍 广州 · 贵州毕节</span>
      </div>
    </div>

    <!-- ========== 2. 个人概要 ========== -->
    <section class="mb-14">
      <div
        class="p-6 rounded-2xl border leading-relaxed text-sm md:text-base"
        style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card); color: var(--color-text-secondary);"
      >
        <p class="mb-3" style="color: var(--color-text);">
          AI 驱动开发方法论构建者，3 年 Web 前端经验。以 OpenSpec + AI Skill 工作流建立团队级 AI 协作规范，覆盖「需求分析 → 架构设计 → 代码生成 → 审查质检」全链路，实现从 AI 工具使用到 AI 方法论输出的进阶。
        </p>
        <p class="mb-3">
          深耕前端性能优化，解决超大日志渲染（47s → 600ms）、海量数据查询（7s → 2.5s）等复杂场景瓶颈。
        </p>
        <p>
          2025 年 12 月起担任预备前端主程，带领 4 名资深工程师，建立代码 Review / 覆盖率 / AI 使用三大质量门禁体系，线上 Bug 率从次均 3 个降至几乎为 0。
        </p>
      </div>
    </section>

    <!-- ========== 3. 专业技能 ========== -->
    <section class="mb-14">
      <h2 class="text-2xl font-extrabold mb-6 tracking-tight"
        style="color: var(--color-text); letter-spacing: -0.02em;">
        专业技能
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- AI 驱动开发 -->
        <div
          class="p-5 rounded-2xl border transition-all duration-200"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <h3 class="font-semibold text-base mb-3 flex items-center gap-2" style="color: var(--color-text);">
            🤖 AI 驱动开发
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {['OpenSpec','Claude','Cursor','ChatGPT','Dify','AI Skill 工作流','AI 全栈开发','AI 代码审查','AI 设计还原','AI 知识库'].map(t => (
              <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full"
                style="background: var(--color-primary-soft); color: var(--color-primary);">{t}</span>
            ))}
          </div>
        </div>
        <!-- 核心技能 -->
        <div
          class="p-5 rounded-2xl border transition-all duration-200"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <h3 class="font-semibold text-base mb-3" style="color: var(--color-text);">
            🔧 核心技能
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {['Vue.js','Webpack','性能优化','虚拟滚动','XSS/CSRF 安全','GDPR 合规','Echarts','SDK 开发','TypeScript'].map(t => (
              <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full"
                style="background: var(--color-primary-soft); color: var(--color-primary);">{t}</span>
            ))}
          </div>
        </div>
        <!-- 扩展能力 -->
        <div
          class="p-5 rounded-2xl border transition-all duration-200"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <h3 class="font-semibold text-base mb-3" style="color: var(--color-text);">
            📐 扩展能力
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {['Node.js / Express / Egg.js','MongoDB / MySQL','Gulp / Eslint','SEO（Canonical/Alternate）','多语言方案','团队代码规范'].map(t => (
              <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full"
                style="background: var(--color-primary-soft); color: var(--color-primary);">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ========== 4. 项目经历 ========== -->
    <section class="mb-14">
      <h2 class="text-2xl font-extrabold mb-6 tracking-tight"
        style="color: var(--color-text); letter-spacing: -0.02em;">
        项目经历
      </h2>
      <div class="space-y-4">

        <!-- 团队管理（前端主程预备） -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <div>
            <h3 class="font-semibold text-base" style="color: var(--color-text);">团队管理 · 前端主程（预备）</h3>
            <p class="text-xs mt-0.5 mb-3" style="color: var(--color-text-muted);">2025.12 – 至今</p>
          </div>
          <ul class="space-y-1.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>· 建立代码 Review、代码覆盖率、AI 使用规范三大质量门禁，线上 Bug 率从次均 3 个降至几乎为 0</li>
            <li>· 设计「AI 先审 → 前置回复 → 人工终审」三级 Review 流程，提升审查吞吐效率</li>
            <li>· 统筹 4 名资深工程师（5-7 年经验）的任务拆解与 4 个业务线架构决策</li>
            <li>· 利用 AI 辅助参与后端开发，推动多项目月/季度计划制定与交付闭环</li>
          </ul>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {['技术管理','代码 Review','AI Review','技术方案评审','跨项目规划','质量治理'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-code-bg); color: var(--color-text-muted);">{t}</span>
            ))}
          </div>
        </div>

        <!-- 技术探索与团队效能提升 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <div>
            <h3 class="font-semibold text-base" style="color: var(--color-text);">技术探索与团队效能提升</h3>
            <p class="text-xs mt-0.5 mb-3" style="color: var(--color-text-muted);">2025.09 – 至今 · 主导者</p>
          </div>
          <ul class="space-y-1.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>· 建立项目专属 OpenSpec，沉淀 Claude + Brainstorming 等可复用 Skill 工作流，形成全链路 AI 开发范式</li>
            <li>· 修复 Bull 队列持久化（Redis）实现服务重启后任务自动恢复，修复队列无限重试 Bug</li>
            <li>· 发现并纠正 MongoDB updateMany 返回值字段错误（nModified → modifiedCount）</li>
            <li>· 落地 Cursor + Figma AI 出码工作流，设计稿还原效率提升 37%</li>
            <li>· 设计实现 Vue2 代码覆盖率插件，支持 Template/Style 全覆盖，对接云效实现可视化</li>
          </ul>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {['OpenSpec','Claude','Cursor + Figma','Dify','AI 全栈','Vue2','SEO','多语言国际化'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-code-bg); color: var(--color-text-muted);">{t}</span>
            ))}
          </div>
        </div>

        <!-- 日志平台 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <div>
            <h3 class="font-semibold text-base" style="color: var(--color-text);">日志查询与分析平台</h3>
            <p class="text-xs mt-0.5 mb-3" style="color: var(--color-text-muted);">2023.10 – 至今 · 前端负责人</p>
          </div>
          <ul class="space-y-1.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>· 虚拟滚动 + 分页解决 300MB+ 海量日志渲染：超长日志 7s → 2.5s，表格 47s → 600ms</li>
            <li>· 实现全键盘操作查询模式，操作效率提升约 20%</li>
            <li>· 建立报障收集与修复机制，日均报错量从 100+ 降至 10+</li>
          </ul>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {['Vue.js','虚拟滚动','分页技术'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-code-bg); color: var(--color-text-muted);">{t}</span>
            ))}
          </div>
        </div>

        <!-- 智能客服 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <div>
            <h3 class="font-semibold text-base" style="color: var(--color-text);">
              智能客服系统
              <a href="https://kf.duoyi.com/" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1 ml-2 text-xs font-normal hover:underline"
                style="color: var(--color-primary);">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                kf.duoyi.com
              </a>
            </h3>
            <p class="text-xs mt-0.5 mb-3" style="color: var(--color-text-muted);">2024.09 – 至今 · 前端负责人</p>
          </div>
          <ul class="space-y-1.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>· 集成 Deepseek AI 至举报/审核模块，自动化准确率 95%，年降本 3 人</li>
            <li>· 页签高亮 + Notification API 优化工单通知，缩短客服响应时间 10 秒</li>
            <li>· 重构多客服入口：jQuery + 原生 JS → Vue 组件体系，降低维护成本</li>
            <li>· 协作客户端团队设计 SDK 调用方案，统一移动端/PC 端客服入口</li>
          </ul>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {['Vue.js','Notification API','Deepseek AI','SDK'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-code-bg); color: var(--color-text-muted);">{t}</span>
            ))}
          </div>
        </div>

        <!-- 埋点平台 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <div>
            <h3 class="font-semibold text-base" style="color: var(--color-text);">网站分析与埋点平台</h3>
            <p class="text-xs mt-0.5 mb-3" style="color: var(--color-text-muted);">2023.10 – 至今 · 前端负责人</p>
          </div>
          <ul class="space-y-1.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>· 基于 Web Vitals 构建性能监控体系，Echarts 可视化；接口响应 1500ms → 220ms，提升超 85%</li>
            <li>· 制定埋点规范，实现 Cookie 管控与数据发送启停功能，符合欧盟 GDPR 条例</li>
            <li>· 建立埋点性能标准，推动 16 个系统 23 个异常埋点优化，最高提升 50%</li>
            <li>· 基于 heatmap.js 实现热力图渲染，开发排名截图自动推送功能</li>
          </ul>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {['Web Vitals','Echarts','heatmap.js','GDPR','SDK'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-code-bg); color: var(--color-text-muted);">{t}</span>
            ))}
          </div>
        </div>

        <!-- 数据门户 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <div>
            <h3 class="font-semibold text-base" style="color: var(--color-text);">数据门户</h3>
            <p class="text-xs mt-0.5 mb-3" style="color: var(--color-text-muted);">2026.04 – 至今 · 性能优化负责人</p>
          </div>
          <ul class="space-y-1.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>· 优化 Echarts 图表筛选后卡顿：搜索图项耗时 14s → 约 300ms，提升超 97%</li>
            <li>· 解决级联选择器 1400+ 子项（约 7000 项）浏览器崩溃问题，改用懒加载实现秒开</li>
          </ul>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {['Echarts','懒加载','性能优化'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-code-bg); color: var(--color-text-muted);">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ========== 5. 工作经历 ========== -->
    <section class="mb-14">
      <h2 class="text-2xl font-extrabold mb-6 tracking-tight"
        style="color: var(--color-text); letter-spacing: -0.02em;">
        工作经历
      </h2>
      <div
        class="p-5 rounded-2xl border"
        style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
      >
        <div class="flex items-start justify-between flex-wrap gap-2 mb-2">
          <h3 class="font-semibold" style="color: var(--color-text);">广州多益网络有限公司</h3>
          <span class="text-xs font-medium px-2.5 py-0.5 rounded-full"
            style="background: var(--color-primary-soft); color: var(--color-primary);">2023.04 – 至今</span>
        </div>
        <p class="text-sm mb-4" style="color: var(--color-text-muted);">技术工程中心</p>

        <div class="space-y-4">
          <div class="relative pl-6" style="border-left: 2px solid var(--color-border-light);">
            <div class="absolute left-[-5px] top-1.5 w-2.5 h-2.5 rounded-full"
              style="background: var(--color-primary);"></div>
            <p class="text-sm font-semibold" style="color: var(--color-text);">Web 前端主程（预备）</p>
            <p class="text-xs mb-1.5" style="color: var(--color-text-muted);">2025.12 – 至今</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              负责前端团队技术管理与质量建设，建立代码 Review / 覆盖率 / AI 使用三大规范体系；统筹 4 名资深工程师的任务分工与 4 个业务线的架构决策，主导多项目月/季度计划制定与交付闭环。利用 AI 辅助参与后端开发。
            </p>
          </div>
          <div class="relative pl-6" style="border-left: 2px solid var(--color-border-light);">
            <div class="absolute left-[-5px] top-1.5 w-2.5 h-2.5 rounded-full"
              style="background: var(--color-border);"></div>
            <p class="text-sm font-semibold" style="color: var(--color-text);">Web 前端开发工程师</p>
            <p class="text-xs mb-1.5" style="color: var(--color-text-muted);">2023.04 – 2025.11</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              负责日志平台、客服系统、埋点平台、数据门户等核心项目的前端开发与性能优化，服务公司全产品线。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== 6. 技术影响力 + 教育 ========== -->
    <section class="mb-14">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- 技术影响力 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <h3 class="font-semibold text-base mb-3" style="color: var(--color-text);">技术影响力</h3>
          <ul class="space-y-2 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
            <li>
              · 开源贡献：
              <a href="https://github.com/mdn/content/pull/41704" target="_blank" rel="noopener noreferrer"
                class="text-xs hover:underline" style="color: var(--color-primary);">
                MDN Web 文档维护 PR
              </a>
            </li>
            <li>· 季度/年度技术分享一等奖，连续三年 A 绩效</li>
            <li>· 自研 Vue2 代码覆盖率插件，搭建 Dify 技术方案审查知识库</li>
            <li>· 聚焦业务痛点，通过技术创新解决核心问题，落地成果量化可见</li>
          </ul>
        </div>

        <!-- 教育经历 -->
        <div
          class="p-5 rounded-2xl border"
          style="background: var(--color-card-bg); border-color: var(--color-border-light); box-shadow: var(--shadow-card);"
        >
          <h3 class="font-semibold text-base mb-3" style="color: var(--color-text);">教育经历</h3>
          <p class="text-sm font-semibold mb-1" style="color: var(--color-text);">
            贵州师范大学求是学院
          </p>
          <p class="text-xs mb-2" style="color: var(--color-text-muted);">
            计算机科学与技术 · 本科 · 理学系 · 2019.09 – 2023.06
          </p>
          <div class="flex flex-wrap gap-1.5">
            {['专业前 1%','贵州省优秀毕业生（2023）','贵州省三好学生（2022）','英语四级'].map(t => (
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full"
                style="background: var(--color-primary-soft); color: var(--color-primary);">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
