---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于我">
  <div class="max-w-article mx-auto py-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <img
        src="https://github.com/fengyinxqy.png"
        alt="avatar"
        class="w-32 h-32 mx-auto mb-6 rounded-full object-cover"
        loading="eager"
      />
      <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-4">
        关于我
      </h1>
      <p class="text-lg text-[var(--color-text-secondary)]">
        前端开发者 / 技术爱好者 / 终身学习者
      </p>
    </div>

    <!-- Introduction -->
    <section class="prose prose-lg dark:prose-invert max-w-none mb-12">
      <h2>你好，欢迎来到我的博客！</h2>
      <p>
        我是一名热爱技术的前端开发者，专注于构建优秀的 Web 应用。在这里，我分享我的学习笔记、技术见解和生活感悟。
      </p>
      <p>
        我相信技术可以改变世界，而分享可以让更多人受益。希望通过这个博客，能与更多志同道合的朋友交流学习。
      </p>
    </section>

    <!-- Skills -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">
        技能专长
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <h3 class="font-semibold text-[var(--color-text)] mb-2">前端开发</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">React</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Vue</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">TypeScript</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Astro</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Next.js</span>
          </div>
        </div>
        <div class="p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <h3 class="font-semibold text-[var(--color-text)] mb-2">CSS & UI</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Tailwind CSS</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Sass</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Framer Motion</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Radix UI</span>
          </div>
        </div>
        <div class="p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <h3 class="font-semibold text-[var(--color-text)] mb-2">后端 & 数据库</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Node.js</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">PostgreSQL</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Prisma</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Supabase</span>
          </div>
        </div>
        <div class="p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <h3 class="font-semibold text-[var(--color-text)] mb-2">工具 & 平台</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Git</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Docker</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">Vercel</span>
            <span class="px-3 py-1 text-sm bg-[var(--color-code-bg)] rounded-full">AWS</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">
        工作经历
      </h2>
      <div class="space-y-6">
        <div class="relative pl-8 border-l-2 border-[var(--color-border)]">
          <div class="absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-[var(--color-primary)]"></div>
          <div>
            <h3 class="font-semibold text-[var(--color-text)]">高级前端工程师</h3>
            <p class="text-[var(--color-primary)]">某科技公司</p>
            <p class="text-sm text-[var(--color-text-secondary)]">2022 - 至今</p>
            <p class="mt-2 text-[var(--color-text-secondary)]">
              负责公司核心产品的前端架构设计和开发，带领团队完成多个重要项目。
            </p>
          </div>
        </div>
        <div class="relative pl-8 border-l-2 border-[var(--color-border)]">
          <div class="absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-[var(--color-primary)]"></div>
          <div>
            <h3 class="font-semibold text-[var(--color-text)]">前端开发工程师</h3>
            <p class="text-[var(--color-primary)]">另一家科技公司</p>
            <p class="text-sm text-[var(--color-text-secondary)]">2020 - 2022</p>
            <p class="mt-2 text-[var(--color-text-secondary)]">
              参与多个 Web 应用的开发，积累了丰富的项目经验。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">
        联系方式
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
        >
          <svg class="h-6 w-6 text-[var(--color-text)]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          <div>
            <p class="font-medium text-[var(--color-text)]">GitHub</p>
            <p class="text-sm text-[var(--color-text-secondary)]">查看我的开源项目</p>
          </div>
        </a>
        <a
          href="mailto:your-email@example.com"
          class="flex items-center gap-3 p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[var(--color-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <div>
            <p class="font-medium text-[var(--color-text)]">Email</p>
            <p class="text-sm text-[var(--color-text-secondary)]">your-email@example.com</p>
          </div>
        </a>
        <a
          href="https://twitter.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
        >
          <svg class="h-6 w-6 text-[var(--color-text)]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          <div>
            <p class="font-medium text-[var(--color-text)]">Twitter</p>
            <p class="text-sm text-[var(--color-text-secondary)]">关注我的动态</p>
          </div>
        </a>
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-4 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
        >
          <svg class="h-6 w-6 text-[var(--color-text)]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          <div>
            <p class="font-medium text-[var(--color-text)]">LinkedIn</p>
            <p class="text-sm text-[var(--color-text-secondary)]">职业社交</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Fun Facts -->
    <section>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">
        一些有趣的事
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="text-center p-6 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <div class="text-3xl font-bold text-[var(--color-primary)] mb-2">5+</div>
          <p class="text-[var(--color-text-secondary)]">年开发经验</p>
        </div>
        <div class="text-center p-6 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <div class="text-3xl font-bold text-[var(--color-primary)] mb-2">50+</div>
          <p class="text-[var(--color-text-secondary)]">个项目</p>
        </div>
        <div class="text-center p-6 bg-[var(--color-card-bg)] rounded-lg border border-[var(--color-border)]">
          <div class="text-3xl font-bold text-[var(--color-primary)] mb-2">1000+</div>
          <p class="text-[var(--color-text-secondary)]">杯咖啡</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
